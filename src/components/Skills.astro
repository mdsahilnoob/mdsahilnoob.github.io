---
import { getCollection } from "astro:content";

const allSkills = await getCollection("skills");
const skillCategories = allSkills.sort((a, b) => a.data.order - b.data.order);
---

<div class="skills-wrapper">
  {
    skillCategories.map((category) => (
      <div class="skill-category slide-up">
        <h3>{category.data.title}</h3>
        <ul class="skill-list">
          {category.data.items.map((skill) => (
            <li class="skill-item" tabindex="0">
              <div class="skill-main">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-level">{skill.level}</span>
              </div>
              {skill.note && <span class="skill-note">{skill.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .skills-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 60px 40px;
    margin-top: 40px;
  }

  .skill-category h3 {
    font-size: 14px;
    font-weight: 500;
    color: var(--tertiary-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .skill-item {
    background: transparent;
    border: 1px solid var(--border-color);
    padding: 10px 16px;
    transition: all 0.2s ease;
    cursor: default;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 140px;
    flex: 1;
  }

  .skill-item:hover,
  .skill-item:focus-visible {
    border-color: var(--primary-text);
    background: var(--hover-bg);
    transform: translateY(-2px);
    outline: none;
  }

  .skill-main {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    gap: 12px;
  }

  .skill-name {
    color: var(--primary-text);
    font-size: 16px;
    font-weight: 400;
  }

  .skill-level {
    font-size: 11px;
    color: var(--tertiary-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .skill-note {
    font-size: 12px;
    color: var(--tertiary-text);
    font-weight: 300;
  }

  @media (max-width: 768px) {
    .skills-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .skill-item {
      flex: 1 1 100%;
    }
  }
</style>

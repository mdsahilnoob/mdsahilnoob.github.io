---

<div class="contact-section">
  <div class="contact-info">
    <p>
      Looking for a developer to bring your ideas to life? I'm open to Remote/
      Freelance opportunities.
    </p>
    <div class="contact-links">
      <a href="mailto:mds603052@gmail.com" class="contact-link">
        <span>mds603052@gmail.com</span>
      </a>
      <a
        href="https://github.com/mdsahilnoob"
        class="contact-link"
        target="_blank"
        rel="noopener"
      >
        <span>github.com/mdsahilnoob</span>
      </a>
      <a
        href="https://www.linkedin.com/in/mdsahilnoob/"
        class="contact-link"
        target="_blank"
        rel="noopener"
      >
        <span>linkedin.com/in/mdsahilnoob</span>
      </a>
      <a
        href="https://x.com/mdsahil_noob"
        class="contact-link"
        target="_blank"
        rel="noopener"
      >
        <span>twitter.com/mdsahil_noob</span>
      </a>
    </div>
  </div>

  <form class="contact-form" id="contactForm">
    <div class="form-group">
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Your name"
        required
      />
    </div>
    <div class="form-group">
      <input
        type="email"
        id="email"
        name="email"
        placeholder="Your email"
        required
      />
    </div>
    <div class="form-group">
      <textarea
        id="message"
        name="message"
        placeholder="Your message"
        rows="5"
        required></textarea>
    </div>
    <button type="submit" class="submit-button">
      <span class="button-text">send message</span>
    </button>
  </form>
</div>

<script
  type="text/javascript"
  src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"
></script>
<script type="text/javascript">
  (function () {
    emailjs.init({
      publicKey: "ZDkpmRIkAqwpFPpjf",
    });
  })();
</script>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const submitButton = form.querySelector(
      ".submit-button"
    ) as HTMLButtonElement;
    const buttonText = submitButton?.querySelector(
      ".button-text"
    ) as HTMLElement;

    if (submitButton) {
      submitButton.disabled = true;
      if (buttonText) buttonText.textContent = "sending...";
    }

    try {
      // Send contact email to you
      await emailjs.sendForm("service_dpy66iq", "template_pmz1lpv", form);

      // Send auto-reply to user
      await emailjs.sendForm("service_dpy66iq", "template_w39qism", form);

      if (submitButton && buttonText) {
        submitButton.classList.add("button-success");
        buttonText.textContent = "message sent";
      }
      form.reset();

      setTimeout(() => {
        if (submitButton && buttonText) {
          submitButton.classList.add("button-slideout");
        }
      }, 3000);

      setTimeout(() => {
        if (submitButton && buttonText) {
          submitButton.classList.remove("button-success", "button-slideout");
          buttonText.textContent = "send message";
          submitButton.disabled = false;
        }
      }, 3600);
    } catch (error) {
      console.error("Failed to send email:", error);

      if (submitButton && buttonText) {
        submitButton.classList.add("button-error");
        buttonText.textContent = "failed to send";
      }
      setTimeout(() => {
        if (submitButton && buttonText) {
          submitButton.classList.add("button-slideout");
        }
      }, 3000);
      setTimeout(() => {
        if (submitButton && buttonText) {
          submitButton.classList.remove("button-error", "button-slideout");
          buttonText.textContent = "send message";
          submitButton.disabled = false;
        }
      }, 3600);
    }
  });
</script>

<style>
  .contact-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 20px;
  }

  .contact-info p {
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 30px;
    color: var(--secondary-text);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--secondary-text);
    padding: 12px 0;
    border-bottom: 1px solid transparent;
    transition: var(--transition-smooth);
  }

  .contact-link:hover {
    color: var(--primary-text);
    border-bottom-color: var(--border-color);
    transform: translateX(5px);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 16px 20px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-color);
    color: var(--primary-text);
    font-family: inherit;
    font-size: 14px;
    transition: var(--transition-smooth);
    resize: vertical;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary-text);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
  }

  [data-theme="dark"] .form-group input:focus,
  [data-theme="dark"] .form-group textarea:focus {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--tertiary-text);
  }

  .submit-button {
    background: #000000;
    color: #ffffff;
    border: none;
    padding: 16px 32px;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-smooth);
    position: relative;
    overflow: hidden;
  }

  .submit-button:hover {
    background: #333333;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .submit-button:disabled {
    cursor: not-allowed;
  }

  .submit-button:disabled:hover {
    transform: none;
  }

  .button-text {
    display: inline-block;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .button-success .button-text {
    animation: slideTextIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .button-success {
    background: #22c55e !important;
  }

  [data-theme="dark"] .button-success {
    background: #16a34a !important;
  }

  .button-error .button-text {
    animation: slideTextIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .button-error {
    background: #dc3545 !important;
  }

  [data-theme="dark"] .button-error {
    background: #ff4757 !important;
  }

  .button-slideout .button-text {
    animation: slideTextOut 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes slideTextIn {
    0% {
      transform: translateX(-100%);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes slideTextOut {
    0% {
      transform: translateX(0);
      opacity: 1;
    }
    100% {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .contact-section {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
